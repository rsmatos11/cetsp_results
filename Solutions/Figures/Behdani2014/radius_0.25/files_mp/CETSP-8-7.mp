v1 = (  0.83585667344703496*u, 0.02196607729619778*u);
v2 = (  0.85892917850075956*u, 0.18696051792158458*u);
v3 = (  0.97241156316790789*u, 0.19649803629991708*u);
v4 = (  0.94233398331763363*u, 0.56343712858619666*u);
v5 = (  0.53081880962998029*u, 0.40635564356096865*u);
v6 = (  0.53861074248379248*u, 0.22692507916534421*u);
