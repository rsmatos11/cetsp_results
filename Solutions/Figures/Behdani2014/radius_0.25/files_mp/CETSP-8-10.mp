w6 = (  0.54167661514131993*u, 0.15654583791996773*u);
w7 = (  0.86354052000806203*u, 0.22508333462534300*u);
w8 = (  0.54163863005627988*u, 0.18018031287306777*u);
w9 = (  1.00000000000000000*u, 0.66096063504860536*u);
r1 =  0.03876029085722259*u;
