v1 = (  0.59694414572946197*u, 0.77325577606152440*u);
v2 = (  0.66764172885950468*u, 0.78718604800622871*u);
v3 = (  0.93944142068139991*u, 0.48787414041754446*u);
v4 = (  0.95929878737169083*u, 0.28036792403827809*u);
v5 = (  0.96239552134146655*u, 0.10695748642883796*u);
v6 = (  0.77475063031053937*u, 0.29440980863899119*u);
v7 = (  0.72756099936008001*u, 0.28598677339326378*u);
