r7 =  0.03727059946032172*u;
r8 =  0.03727059946032172*u;
r9 =  0.00000000000000000*u;
v1 = (  0.00149232225651117*u, 0.42010301593690830*u);
v2 = (  0.12273680919624044*u, 0.28427344885252626*u);
v3 = (  0.36328215278025650*u, 0.02979109659148333*u);
v4 = (  0.70781544450376288*u, 0.34204129202570216*u);
v5 = (  0.83623258835328973*u, 0.39772540452036659*u);
v6 = (  0.96384187431977786*u, 0.55018600263404571*u);
