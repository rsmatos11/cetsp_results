r9 =  0.00000000000000000*u;
v1 = (  0.05594180107352196*u, 0.05291150591996673*u);
v2 = (  0.11263319146584520*u, 0.16028926297865112*u);
v3 = (  0.35732557769563056*u, 0.58001913963560403*u);
v4 = (  0.97143990098796695*u, 0.53343230001360953*u);
v5 = (  0.94318314011273285*u, 0.15209495761148883*u);
