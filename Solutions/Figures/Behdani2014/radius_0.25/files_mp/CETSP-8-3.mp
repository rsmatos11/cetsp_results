v1 = (  0.31108068038240472*u, 0.21711545905362870*u);
v2 = (  0.44308436554999864*u, 0.08549022984934357*u);
v3 = (  0.56710888194759490*u, 0.13172818949702950*u);
v4 = (  0.79564764743373140*u, 0.05879963944683651*u);
v5 = (  0.96827847362001529*u, 0.02967421694493524*u);
