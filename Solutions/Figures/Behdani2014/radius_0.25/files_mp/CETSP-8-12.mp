v1 = (  1.00000000000000000*u, 0.03249592399508867*u);
v2 = (  0.45438800613165725*u, 0.14550005409361155*u);
v3 = (  0.46910595947698980*u, 0.30701434236866421*u);
v4 = (  0.25882486560418494*u, 0.50813261062635373*u);
v5 = (  0.62524037710703440*u, 0.42867917764521613*u);
