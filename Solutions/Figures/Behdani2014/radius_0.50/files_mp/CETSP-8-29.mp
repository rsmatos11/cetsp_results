v1 = (  0.07166664542360783*u, 0.24817160992645651*u);
v2 = (  0.40554722983919983*u, 0.50075568591389730*u);
v3 = (  0.45805551110077763*u, 0.46702982924968300*u);
v4 = (  0.61206607676313307*u, 0.47601185088503312*u);
v5 = (  0.94027368977398085*u, 0.54280740130589555*u);
