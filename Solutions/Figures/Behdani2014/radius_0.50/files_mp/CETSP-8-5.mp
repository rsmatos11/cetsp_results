v1 = (  0.16934322113517644*u, 0.41169750341354644*u);
v2 = (  0.44175578749229016*u, 0.07194840265173313*u);
v3 = (  0.48379744808647851*u, 0.06974654231455915*u);
v4 = (  0.67130158928642791*u, 0.21098280830972829*u);
v5 = (  0.72318100081385395*u, 0.29381932382234455*u);
