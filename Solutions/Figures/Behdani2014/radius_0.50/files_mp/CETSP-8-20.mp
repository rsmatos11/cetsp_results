v1 = (  0.96740236155799542*u, 0.60800623921512487*u);
v2 = (  0.94979346992424385*u, 0.64309662567338088*u);
v3 = (  0.63145830282402793*u, 0.49801003262269361*u);
v4 = (  0.18374571682092752*u, 0.61194959341876787*u);
v5 = (  0.14817212159406457*u, 0.47640214764890820*u);
v6 = (  0.11259860291447493*u, 0.34085456596816965*u);
v7 = (  0.49332977057626842*u, 0.22795282005254455*u);
