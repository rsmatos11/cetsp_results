v1 = (  0.74097778771511813*u, 0.08002850774530286*u);
v2 = (  0.65435348155403794*u, 0.25021587924198768*u);
v3 = (  0.59497940590292431*u, 0.27333026849832787*u);
v4 = (  0.53563432679716605*u, 0.29645845821243955*u);
