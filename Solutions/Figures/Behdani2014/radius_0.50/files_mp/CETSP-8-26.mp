v1 = (  0.39355052435033433*u, 0.46481465370123748*u);
v2 = (  0.81556724333023800*u, 0.55270337350260879*u);
v3 = (  0.93397591877271446*u, 0.28791185505660616*u);
v4 = (  0.94255202587092868*u, 0.09494384260877357*u);
