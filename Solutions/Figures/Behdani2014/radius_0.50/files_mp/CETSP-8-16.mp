v1 = (  0.31544182868256276*u, 0.62024809950261828*u);
v2 = (  0.10316573407979700*u, 0.55689675731628507*u);
v3 = (  0.12480129783351998*u, 0.31519719994623996*u);
v4 = (  0.14643714778102646*u, 0.07349752281189191*u);
v5 = (  0.25271442393336896*u, 0.16100694086692227*u);
