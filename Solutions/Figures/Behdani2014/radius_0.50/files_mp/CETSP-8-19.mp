v1 = (  0.14697606253053247*u, 0.59115918766138598*u);
v2 = (  0.41339304214646500*u, 0.49607042554730268*u);
v3 = (  0.79527539885939369*u, 0.56270307410043130*u);
v4 = (  0.93161253233356067*u, 0.42634309623973937*u);
v5 = (  0.80220517520022872*u, 0.39783832829433152*u);
