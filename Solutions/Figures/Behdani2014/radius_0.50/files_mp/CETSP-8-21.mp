v1 = (  0.33605645014402613*u, 0.07463049036340455*u);
v2 = (  0.84694914226613183*u, 0.11328478445581919*u);
v3 = (  0.83476825863236559*u, 0.40420227039710283*u);
v4 = (  0.93393565727909955*u, 0.52308415216912596*u);
v5 = (  0.58409326986561150*u, 0.63066055239428209*u);
v6 = (  0.41934566324687200*u, 0.59413380548404027*u);
