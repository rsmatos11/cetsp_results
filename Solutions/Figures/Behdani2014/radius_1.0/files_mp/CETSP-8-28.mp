v1 = (  0.90414833047413046*u, 0.28309713831083261*u);
v2 = (  0.89295414627988667*u, 0.32210158464488259*u);
v3 = (  0.88175895213443578*u, 0.36110670410610252*u);
v4 = (  0.63754399359390745*u, 0.33277660306316137*u);
v5 = (  0.56602928454930990*u, 0.32448108887813776*u);
