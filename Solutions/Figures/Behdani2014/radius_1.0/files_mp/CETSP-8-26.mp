v1 = (  0.38080791073868536*u, 0.44976460760378961*u);
v2 = (  0.77214707933740667*u, 0.50719848509354937*u);
v3 = (  0.87250266539268462*u, 0.27001223156494891*u);
v4 = (  0.88820980027279928*u, 0.11381965262625134*u);
