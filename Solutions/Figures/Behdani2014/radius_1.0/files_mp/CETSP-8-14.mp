v1 = (  0.59137947628794540*u, 0.55677803514940738*u);
v2 = (  0.16776479769056346*u, 0.52687473382466110*u);
v3 = (  0.25951129648248905*u, 0.35930435384102366*u);
v4 = (  0.21847988801047161*u, 0.23384686378472971*u);
v5 = (  0.33614803188109432*u, 0.17180905674139380*u);
v6 = (  0.71975144351611109*u, 0.08579021300712437*u);
