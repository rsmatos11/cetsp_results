r7 =  0.14417012074247612*u;
r8 =  0.14417012074247612*u;
r9 =  0.00000000000000000*u;
v1 = (  0.65251612903225809*u, 0.27041557037304015*u);
v2 = (  0.54665169510242639*u, 0.12604469560411080*u);
v3 = (  0.33305485838736509*u, 0.18511946732056878*u);
v4 = (  0.27346858718633982*u, 0.49341342049313563*u);
v5 = (  0.62058827119168047*u, 0.58308565450026650*u);
v6 = (  0.67807675088585695*u, 0.52315941717913139*u);
