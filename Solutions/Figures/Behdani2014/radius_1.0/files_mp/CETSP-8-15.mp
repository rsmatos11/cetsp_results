v1 = (  0.08478722551690977*u, 0.05115770422610461*u);
v2 = (  0.38461737205278518*u, 0.15810484044843084*u);
v3 = (  0.59994644502567007*u, 0.23491107451956611*u);
v4 = (  0.74856337629920044*u, 0.26308609591519572*u);
