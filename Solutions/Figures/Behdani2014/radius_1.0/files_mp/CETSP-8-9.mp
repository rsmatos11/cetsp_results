r8 =  0.13933495426330128*u;
r9 =  0.00000000000000000*u;
v1 = (  0.93873442061042656*u, 0.08591741617260815*u);
v2 = (  0.32374129972680060*u, 0.16480323990244594*u);
v3 = (  0.22231604999133281*u, 0.13707171371278268*u);
v4 = (  0.05222986193711915*u, 0.09057128776159448*u);
v5 = (  0.17724027106464857*u, 0.47458043119668791*u);
v6 = (  0.22572020525237491*u, 0.50430958767621692*u);
