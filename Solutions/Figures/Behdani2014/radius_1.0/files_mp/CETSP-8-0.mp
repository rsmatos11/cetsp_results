v1 = (  0.00141330989594364*u, 0.39786027927202899*u);
v2 = (  0.17191371098552627*u, 0.24092327991200385*u);
v3 = (  0.34549298973587084*u, 0.08114081473829646*u);
v4 = (  0.60638998452606419*u, 0.29375528174651455*u);
v5 = (  0.75722630817395264*u, 0.41667730735530178*u);
