v1 = (  0.32509119860086011*u, 0.07219535751809289*u);
v2 = (  0.79831399856636487*u, 0.13480031183360144*u);
v3 = (  0.83974642353809337*u, 0.38491348369220935*u);
v4 = (  0.87651089489695466*u, 0.48584459665829471*u);
